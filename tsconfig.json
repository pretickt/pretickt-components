{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "useDefineForClassFields": false,
    "experimentalDecorators": false,
    "noEmit": true
  },
  "include": [
    "src",
    "components",
    "scripts",
    "src/**/*.vue",
    "components/**/*.vue"
  ]
}