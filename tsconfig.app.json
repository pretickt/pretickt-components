/* Angular build (the site app): entry points only — the compiler follows their imports. */
{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "useDefineForClassFields": false,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@pretickt/components/context": ["./src/context/index.ts"],
      "@pretickt/components/ds": ["./src/ds/index.ts"],
      "@pretickt/components/format": ["./src/ds/format.ts"],
      "@pretickt/components/typologies": ["./src/typologies/browser.ts"],
      "@pretickt/components/api": ["./src/api.ts"]
    }
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "extendedDiagnostics": { "defaultCategory": "error" }
  },
  "files": ["src/site/main.ts", "src/site/main.server.ts", "src/site/server.ts"]
}
