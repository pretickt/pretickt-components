{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "site": {
      "projectType": "application",
      "root": "",
      "sourceRoot": ".",
      "prefix": "pt",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/site",
            "index": "src/site/index.html",
            "browser": "src/site/main.ts",
            "server": "src/site/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/site/server.ts"
            },
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": [],
            "security": {
              "allowedHosts": [
                "localhost"
              ]
            }
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "include": [
              "src/**/*.spec.ts",
              "components/**/*.spec.ts"
            ]
          }
        }
      }
    },
    "stories": {
      "projectType": "application",
      "root": "src/stories",
      "sourceRoot": "src/stories",
      "prefix": "pt",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/stories",
            "index": "src/stories/index.html",
            "browser": "src/stories/main.ts",
            "tsConfig": "tsconfig.stories.json",
            "styles": [
              "src/stories/stories.css",
              "components/drafts/drafts.css"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "styles/fonts",
                "output": "fonts"
              },
              {
                "glob": "**/*",
                "input": "styles/brand",
                "output": "brand"
              },
              {
                "glob": "*.css",
                "input": ".stories",
                "output": "."
              }
            ],
            "optimization": false,
            "extractLicenses": false,
            "sourceMap": true
          },
          "configurations": {
            "experiments": {
              "fileReplacements": [
                {
                  "replace": "src/stories/experiments.ts",
                  "with": ".stories/experiments.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "stories:build",
            "port": 4300,
            "proxyConfig": "src/stories/proxy.json"
          },
          "configurations": {
            "experiments": {
              "buildTarget": "stories:build:experiments"
            }
          }
        }
      }
    }
  }
}
